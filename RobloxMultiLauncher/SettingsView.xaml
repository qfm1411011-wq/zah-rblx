<UserControl x:Class="RobloxMultiLauncher.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft JhengHei UI">
    <UserControl.Resources>
        <RadialGradientBrush x:Key="GlowPurple">
            <GradientStop Color="#387B4DFF" Offset="0"/>
            <GradientStop Color="#007B4DFF" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="GlowPink">
            <GradientStop Color="#26D6459B" Offset="0"/>
            <GradientStop Color="#00D6459B" Offset="1"/>
        </RadialGradientBrush>

        <!-- 一張設定卡 -->
        <Style x:Key="SetCard" TargetType="Border">
            <Setter Property="Background" Value="#B315131F"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20,16,20,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Width" Value="58"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowLine" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,13,0,13"/>
            <Setter Property="Background" Value="#262239"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Ellipse Width="560" Height="340" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-170,-130,0,0"
                 Fill="{StaticResource GlowPurple}" IsHitTestVisible="False"/>
        <Ellipse Width="440" Height="300" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-110,-120,0"
                 Fill="{StaticResource GlowPink}" IsHitTestVisible="False"/>

        <Grid Margin="28,24,28,20" MaxWidth="820">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="Hdr" Margin="0,0,0,16">
                <TextBlock Text="設定" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TitleGrad}"/>
                <TextBlock Text="語言、視窗、聲音、啟動行為與資料。所有變更會立即套用並自動儲存。" FontSize="12.5" Margin="0,6,0,0"
                           TextWrapping="Wrap" Foreground="{StaticResource TextDim}"/>
            </StackPanel>

            <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel x:Name="Cards">

                    <!-- ===== 語言 ===== -->
                    <Border Style="{StaticResource SetCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="🌐  語言" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="切換整個軟體的介面語言,立刻生效。" Style="{StaticResource RowDesc}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource InputBg}" CornerRadius="12" Padding="3" VerticalAlignment="Center"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="LangZh" Style="{StaticResource SegBtn}" GroupName="lang" Content="繁體中文" MinWidth="104" Click="Lang_Click" Tag="zh"/>
                                    <RadioButton x:Name="LangEn" Style="{StaticResource SegBtn}" GroupName="lang" Content="English" MinWidth="104" Click="Lang_Click" Tag="en"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ===== 視窗與外觀 ===== -->
                    <Border Style="{StaticResource SetCard}">
                        <StackPanel>
                            <TextBlock Text="🪟  視窗與外觀" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="視窗置頂" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="讓本軟體浮在其他視窗上面(跟標題列的釘選按鈕同步)。" Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <ToggleButton x:Name="TopSw" Grid.Column="1" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center" Click="TopSw_Click"/>
                            </Grid>
                            <Border Style="{StaticResource RowLine}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="開啟時播放開場動畫" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="關閉後,下次開啟軟體會直接進入主畫面(含開場音效)。" Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <ToggleButton x:Name="IntroSw" Grid.Column="1" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center" Click="IntroSw_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== 聲音 ===== -->
                    <Border Style="{StaticResource SetCard}">
                        <StackPanel>
                            <TextBlock Text="🔊  聲音" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="主音量" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                <Slider x:Name="MasterSl" Grid.Column="1" Style="{StaticResource AudioSlider}" Minimum="0" Maximum="1" ValueChanged="Master_Changed"/>
                                <TextBlock x:Name="MasterTx" Grid.Column="2" Style="{StaticResource ValueText}"/>
                            </Grid>
                            <Border Style="{StaticResource RowLine}"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="背景音樂" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                <Slider x:Name="BgmSl" Grid.Column="1" Style="{StaticResource AudioSlider}" Minimum="0" Maximum="1" ValueChanged="Bgm_Changed"/>
                                <TextBlock x:Name="BgmTx" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                <ToggleButton x:Name="BgmSw" Grid.Column="3" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center" Margin="10,0,0,0" Click="BgmSw_Click"/>
                            </Grid>
                            <Border Style="{StaticResource RowLine}"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="介面音效" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                <Slider x:Name="SfxSl" Grid.Column="1" Style="{StaticResource AudioSlider}" Minimum="0" Maximum="1" ValueChanged="Sfx_Changed"/>
                                <TextBlock x:Name="SfxTx" Grid.Column="2" Style="{StaticResource ValueText}"/>
                                <ToggleButton x:Name="SfxSw" Grid.Column="3" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center" Margin="10,0,0,0" Click="SfxSw_Click"/>
                            </Grid>
                            <Border Style="{StaticResource RowLine}"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="放在背景時靜音" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="縮小或切去玩遊戲、其他視窗時,音效立刻停止、音樂淡出,回來就恢復。" Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <ToggleButton x:Name="QuietSw" Grid.Column="1" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center" Click="QuietSw_Click"/>
                            </Grid>
                            <Border Style="{StaticResource RowLine}"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BtnBase}" FontSize="12.5" Padding="14,9" Click="Preview_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Ico}" Text="&#xE768;" FontSize="12" Margin="0,0,7,0"/>
                                        <TextBlock Text="試聽音效"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnBase}" FontSize="12.5" Padding="14,9" Margin="8,0,0,0" Click="ResetAudio_Click">
                                    <TextBlock Text="恢復聲音預設"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== 啟動行為 ===== -->
                    <Border Style="{StaticResource SetCard}">
                        <StackPanel>
                            <TextBlock Text="🚀  啟動行為" Style="{StaticResource CardTitle}" Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="啟動冷卻" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="每個帳號之間的間隔" Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <Slider x:Name="CoolSl" Grid.Column="1" Style="{StaticResource AudioSlider}" Minimum="10" Maximum="60"
                                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Cool_Changed"/>
                                <TextBlock x:Name="CoolTx" Grid.Column="2" Style="{StaticResource ValueText}"/>
                            </Grid>
                            <TextBlock Text="調太短比較容易被 Roblox 暫時限流(429),建議維持 20 秒以上。" Style="{StaticResource RowDesc}" Margin="0,6,0,0"/>
                            <Border Style="{StaticResource RowLine}"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="失敗自動重試" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="每個帳號最多嘗試次數" Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <Slider x:Name="RetrySl" Grid.Column="1" Style="{StaticResource AudioSlider}" Minimum="1" Maximum="8"
                                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Retry_Changed"/>
                                <TextBlock x:Name="RetryTx" Grid.Column="2" Style="{StaticResource ValueText}"/>
                            </Grid>
                            <Border Style="{StaticResource RowLine}"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="啟動後自動排列視窗" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="帳號啟動完成後,自動把 Roblox 視窗整齊排開。" Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <ToggleButton x:Name="ArrangeSw" Grid.Column="1" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center" Click="ArrangeSw_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== 資料與紀錄 ===== -->
                    <Border Style="{StaticResource SetCard}">
                        <StackPanel>
                            <TextBlock Text="🗂  資料與紀錄" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="帳號、設定與啟動紀錄都存在這台電腦的 AppData 資料夾。" Style="{StaticResource RowDesc}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BtnBase}" FontSize="12.5" Padding="14,9" Click="OpenFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Ico}" Text="&#xE8B7;" FontSize="12" Margin="0,0,7,0"/>
                                        <TextBlock Text="開啟資料夾"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BtnSoftDanger}" FontSize="12.5" Padding="14,9" Margin="8,0,0,0" Click="ClearLog_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Ico}" Text="&#xE74D;" FontSize="12" Margin="0,0,7,0"/>
                                        <TextBlock Text="清除啟動紀錄"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== 關於 ===== -->
                    <Border Style="{StaticResource SetCard}">
                        <StackPanel>
                            <TextBlock Text="ℹ️  關於" Style="{StaticResource CardTitle}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="VerText" FontSize="13" Foreground="{StaticResource TextMain}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="CheckUpdateBtn" Style="{StaticResource BtnBase}" FontSize="12.5" Padding="14,9" Click="CheckUpdate_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Ico}" Text="&#xE72C;" FontSize="12" Margin="0,0,7,0"/>
                                        <TextBlock Text="檢查更新"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="UpdateStatusText" FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource TextMain}"/>
                            </StackPanel>
                            <Border Style="{StaticResource RowLine}" Margin="0,12,0,0"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="啟動時自動檢查更新" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="開啟軟體時在背景查看有沒有新版本,有的話才會提醒你(不會自動下載或安裝)。" Style="{StaticResource RowDesc}"/>
                                </StackPanel>
                                <ToggleButton x:Name="AutoUpdateSw" Grid.Column="1" Style="{StaticResource SwitchStyle}" VerticalAlignment="Center" Click="AutoUpdateSw_Click"/>
                            </Grid>
                            <TextBlock Text="這是非官方的第三方工具,與 Roblox 公司無關。Cookie 以 Windows DPAPI 加密存在本機,請只新增你自己的帳號。連點器與按鍵連按請遵守各遊戲的規則。"
                                       Style="{StaticResource RowDesc}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
